# Contact form (server-side only)
RESEND_API_KEY=
# Optional — override the contact email sender/recipient.
# CONTACT_FROM must be a Resend-verified domain, not onboarding@resend.dev.
CONTACT_FROM=
CONTACT_TO=

# Sanity image CDN (see src/app/lib/cms/image.js).
# NEXT_PUBLIC_* is correct here: these two are baked into client bundles because
# the image loader runs in the browser. They are not secrets — a Sanity project
# id and dataset name are public in every asset URL anyway.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity write token — LOCAL SCRIPTS ONLY (npm run photos:upload, sanity:backup).
# Never used by the app, never NEXT_PUBLIC_ (that would inline a write credential
# into the browser bundle), and NOT added to Vercel. Create one at
# sanity.io/manage -> API -> Tokens, Editor role.
SANITY_WRITE_TOKEN=

# Sanity webhook -> /api/revalidate (server-side only). Any long random string;
# the SAME value goes in the webhook's "Secret" field. See docs/vercel-deploy.md.
SANITY_REVALIDATE_SECRET=

# Maintenance mode — leave EMPTY normally. MAINTENANCE_MODE=1 (then rebuild /
# redeploy) shows every visitor the "back shortly" page with HTTP 503.
# MAINTENANCE_BYPASS_SECRET: a long random string; open
# /api/maintenance-bypass?key=<it> to see the real site meanwhile.
# MAINTENANCE_RETRY_AFTER: seconds crawlers should wait (default 3600).
# See docs/vercel-deploy.md -> "Maintenance mode".
MAINTENANCE_MODE=
MAINTENANCE_BYPASS_SECRET=
MAINTENANCE_RETRY_AFTER=

# The Studio reads its own SANITY_STUDIO_* vars — it cannot see NEXT_PUBLIC_*
# at runtime. Set this to the same project id, or paste the id directly into
# sanity.config.js (it is public and never changes).
SANITY_STUDIO_PROJECT_ID=
